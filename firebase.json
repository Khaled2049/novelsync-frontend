{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "hosting": {
      "port": 5033,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": true
    },
    "auth": {
      "port": 9099,
      "host": "127.0.0.1"
    },
    "singleProjectMode": true,
    "functions": {
      "port": 5001,
      "host": "127.0.0.1"
    },
    "firestore": {
      "port": 8080,
      "host": "127.0.0.1",
      "rules": "firestore.rules"
    },
    "storage": {
      "port": 9199,
      "host": "127.0.0.1"
    },
    "database": {
      "port": 9000,
      "host": "127.0.0.1"
    },
    "pubsub": {
      "port": 8085,
      "host": "127.0.0.1"
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" ci",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "novelsync/**",
        "__pycache__/**",
        "*.py",
        "*.pyc",
        "requirements.txt",
        "Dockerfile",
        "cloudbuild.yaml",
        ".dockerignore",
        "start-local.*",
        "*.md",
        "readme.md",
        "LOCAL_DEVELOPMENT.md",
        "API_DOCUMENTATION.md"
      ]
    }
  ]
}
