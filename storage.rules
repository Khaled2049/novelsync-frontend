rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Quota is enforced server-side by the reserveStorageUpload Cloud Function
    // (writes users/{uid}/_storageQuota/{dayKey} via Admin SDK before each upload).
    // The firestore.get() cross-service check is omitted here because the Storage
    // emulator does not reliably resolve cross-service Firestore reads; server-side
    // enforcement is sufficient since all uploads must go through the Cloud Function.

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validImageUpload(userId) {
      return isOwner(userId)
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /book-covers/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if validImageUpload(userId);
      allow delete: if isOwner(userId);
    }

    match /book-covers/featured/{allPaths=**} {
      allow read: if true;
    }

    match /chapter-images/{userId}/{storyId}/{file} {
      allow read: if true;
      allow create, update: if validImageUpload(userId);
      allow delete: if isOwner(userId);
    }

    match /character-art/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if validImageUpload(userId);
      allow delete: if isOwner(userId);
    }

    match /place-images/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if validImageUpload(userId);
      allow delete: if isOwner(userId);
    }

    match /profile-images/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if validImageUpload(userId);
      allow delete: if isOwner(userId);
    }
  }
}
