rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function storyIsVisibleTo(storyId) {
      let s = get(/databases/$(database)/documents/stories/$(storyId)).data;
      return s.isPublished == true || (request.auth != null && s.userId == request.auth.uid);
    }

    function clubMembers(data) {
      let members = data.get("members", []);
      return members is list ? members : [];
    }

    // Per-user story cap. Reads the denormalized counter maintained by the
    // onStoryWrite Cloud Function; treats a missing user doc / field as 0. Bounds the
    // total embedding/storage cost one account can drive (soft cap — see
    // storyCountTrigger.ts). Keep MAX_STORIES_PER_USER in sync with that doc.
    function userStoryCount(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.get("storyCount", 0)
        : 0;
    }

    // True if the requester owns the parent post. Used so a post author can
    // cascade-delete the post's child docs (comments/votes/reports) created by
    // other users — the deletePost() batch in PostService relies on this.
    function isPostAuthor(postId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/posts/$(postId))
        && get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid;
    }

    // Invites collection for invite-only signup
    match /invites/{email} {
      // enforce linkSentCount == 0 on create — prevent injecting a pre-incremented counter.
      allow create: if request.auth == null
                    && request.resource.data.email == email
                    && request.resource.data.status == "pending"
                    && request.resource.data.linkSentCount == 0
                    && request.resource.data.keys().hasAll(["email", "status", "requestedAt", "linkSentCount"]);

      // Unauthenticated get is intentional — allows invite status check before login.
      // list=false prevents email enumeration via collection scans.
      allow get: if request.auth == null ||
                   (request.auth != null && request.auth.token.email == email);
      allow list: if false;

      // scope update to status field only — other fields immutable after create.
      allow update: if request.auth != null
                    && request.auth.token.email != null
                    && request.auth.token.email == email
                    && request.resource.data.status == "completed"
                    && (resource.data.status == "sent" || resource.data.status == "approved")
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']);

      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.content.size() <= 10000;
      allow update, delete: if request.auth != null && resource.data.creator == request.auth.uid;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.content.size() <= 10000;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null;
      // counters must change by exactly ±1 and stay >= 0 — prevents arbitrary value injection.
      allow update: if request.auth != null && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) &&
         request.resource.data.commentCount >= 0 &&
         (request.resource.data.commentCount == resource.data.commentCount + 1 ||
          request.resource.data.commentCount == resource.data.commentCount - 1)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoteCount', 'downvoteCount']) &&
         request.resource.data.upvoteCount >= 0 &&
         request.resource.data.downvoteCount >= 0 &&
         request.resource.data.upvoteCount >= resource.data.upvoteCount - 1 &&
         request.resource.data.upvoteCount <= resource.data.upvoteCount + 1 &&
         request.resource.data.downvoteCount >= resource.data.downvoteCount - 1 &&
         request.resource.data.downvoteCount <= resource.data.downvoteCount + 1) ||
        resource.data.authorId == request.auth.uid
      );
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;

      match /reports/{reportId} {
        // get is per-doc (own report or post author); list can't reference reportId,
        // so it's restricted to the post author (needed for the deletePost cascade).
        allow get: if request.auth != null && (reportId == request.auth.uid || isPostAuthor(postId));
        allow list: if isPostAuthor(postId);
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        // Reports immutable after create
        allow update: if false;
        allow delete: if request.auth != null && (reportId == request.auth.uid || isPostAuthor(postId));
      }

      match /votes/{voteId} {
        allow read: if true;
        allow create: if request.auth != null && voteId == request.auth.uid;
        allow update: if request.auth != null && voteId == request.auth.uid;
        allow delete: if request.auth != null && (voteId == request.auth.uid || isPostAuthor(postId));
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null;
        // vote counter delta bounded to ±1, non-negative.
        allow update: if request.auth != null && (
          resource.data.authorId == request.auth.uid ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoteCount', 'downvoteCount']) &&
           request.resource.data.upvoteCount >= 0 &&
           request.resource.data.downvoteCount >= 0 &&
           request.resource.data.upvoteCount >= resource.data.upvoteCount - 1 &&
           request.resource.data.upvoteCount <= resource.data.upvoteCount + 1 &&
           request.resource.data.downvoteCount >= resource.data.downvoteCount - 1 &&
           request.resource.data.downvoteCount <= resource.data.downvoteCount + 1)
        );
        allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isPostAuthor(postId));

        match /votes/{voteId} {
          allow read: if true;
          allow create: if request.auth != null && voteId == request.auth.uid;
          allow update: if request.auth != null && voteId == request.auth.uid;
          allow delete: if request.auth != null && (voteId == request.auth.uid || isPostAuthor(postId));
        }
      }
    }

    match /plotTemplates/{templateId} {
      allow read: if true;
      // enforce userId on create so ownership is consistent with update/delete.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if resource.data.isPublished == true
                  || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && userStoryCount(request.auth.uid) < 100; // MAX_STORIES_PER_USER

      allow update: if (
        // Unauthenticated view increment: exactly +1 only.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.views == resource.data.views + 1
      ) ||
      (request.auth != null && (
        // likes delta bounded to ±1, non-negative — prevents arbitrary counter injection.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
         request.resource.data.likes >= 0 &&
         (request.resource.data.likes == resource.data.likes + 1 ||
          request.resource.data.likes == resource.data.likes - 1)) ||
        // averageRating bounded to valid 1–5 range.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['averageRating']) &&
         request.resource.data.averageRating >= 1 &&
         request.resource.data.averageRating <= 5) ||
        // ratingsCount increment-only (ratings are permanent).
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingsCount']) &&
         request.resource.data.ratingsCount >= 0 &&
         request.resource.data.ratingsCount == resource.data.ratingsCount + 1) ||
        // combined averageRating+ratingsCount — both constraints must hold.
        (request.resource.data.diff(resource.data).affectedKeys().hasAll(['averageRating', 'ratingsCount']) &&
         request.resource.data.diff(resource.data).affectedKeys().size() == 2 &&
         request.resource.data.averageRating >= 1 &&
         request.resource.data.averageRating <= 5 &&
         request.resource.data.ratingsCount >= 0 &&
         request.resource.data.ratingsCount == resource.data.ratingsCount + 1) ||
        resource.data.userId == request.auth.uid
      ));

      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      match /likes/{likeId} {
        allow read: if true;
        allow create: if request.auth != null &&
          request.resource.data.userId == request.auth.uid &&
          likeId == request.auth.uid;
        allow delete: if request.auth != null && likeId == request.auth.uid;
      }

      match /ratings/{ratingId} {
        allow read: if true;
        allow create: if request.auth != null &&
          request.resource.data.userId == request.auth.uid &&
          ratingId == request.auth.uid &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5;
      }

      match /chapters/{chapterId} {
        allow read: if storyIsVisibleTo(storyId);
        allow create: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid &&
          (!('content' in request.resource.data) || request.resource.data.content.size() <= 100000);
        allow update: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid &&
          (!('content' in request.resource.data) || request.resource.data.content.size() <= 100000);
        allow delete: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;

        match /comments/{commentId} {
          allow read: if true;
          allow create: if request.auth != null &&
            request.resource.data.userId == request.auth.uid;
          allow update: if request.auth != null &&
            resource.data.userId == request.auth.uid &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message', 'updatedAt']);
          allow delete: if request.auth != null &&
            resource.data.userId == request.auth.uid;

          match /likes/{likeId} {
            allow read: if true;
            // constrain likeId == auth.uid — prevents multiple likes per user on same comment.
            allow create: if request.auth != null &&
              likeId == request.auth.uid &&
              request.resource.data.userId == request.auth.uid;
            allow delete: if request.auth != null &&
              likeId == request.auth.uid;
          }
        }
      }

      match /plots/{plotId} {
        allow read: if storyIsVisibleTo(storyId);
        allow create: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
        allow update, delete: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
      }

      match /characters/{characterId} {
        allow read: if storyIsVisibleTo(storyId);
        allow create: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
        allow update, delete: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
      }

      match /places/{placeId} {
        allow read: if storyIsVisibleTo(storyId);
        allow create: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
        allow update, delete: if request.auth != null &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
      }

      match /chats/{chatId} {
        allow read, write: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/stories/$(storyId)).data.userId;

        match /messages/{messageId} {
          allow read, write: if request.auth != null &&
            request.auth.uid == get(/databases/$(database)/documents/stories/$(storyId)).data.userId;
        }
      }
    }


    // Async generation jobs (chapter/story/brainstorm). Created and updated
    // ONLY by Cloud Functions via the Admin SDK. Owners may read their own job
    // to observe progress/completion in realtime (replaces HTTP polling). The
    // owner uid is denormalized onto the job doc so this is a cheap field
    // compare — no cross-doc story lookup.
    match /jobs/{jobId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /bookClubs/{clubId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.members is list;
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
      // members update — non-creators may only add/remove themselves (mirrors follower logic).
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.creatorId ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) && (
          // Join: add yourself only
          (clubMembers(request.resource.data).size() == clubMembers(resource.data).size() + 1 &&
           clubMembers(request.resource.data).hasAll(clubMembers(resource.data)) &&
           !clubMembers(resource.data).hasAny([request.auth.uid])) ||
          // Leave: remove yourself only
          (clubMembers(request.resource.data).size() == clubMembers(resource.data).size() - 1 &&
           clubMembers(resource.data).hasAll(clubMembers(request.resource.data)) &&
           clubMembers(resource.data).hasAny([request.auth.uid]))
        )) ||
        // discussionPrompts / polls — members may reply to a thread or cast a
        // vote, both of which rewrite the whole array (client does read+map+write).
        // New threads/polls are creator-only (gated in the UI), so member writes
        // must not change the top-level list length. Rules can't cheaply verify
        // "only my own nested entry changed", so a member could in principle
        // clobber another member's response/vote in the same write — same trust
        // level as the /messages subcollection's membership check.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['discussionPrompts']) &&
         clubMembers(resource.data).hasAny([request.auth.uid]) &&
         request.resource.data.discussionPrompts.size() == resource.data.discussionPrompts.size()) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['polls']) &&
         clubMembers(resource.data).hasAny([request.auth.uid]) &&
         request.resource.data.polls.size() == resource.data.polls.size())
      );

      match /messages/{messageId} {
        allow read: if true;
        // require membership or creator status — prevents non-members from posting.
        // senderId must match the caller — prevents impersonating another user.
        allow create: if request.auth != null &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.content.size() <= 10000 && (
          get(/databases/$(database)/documents/bookClubs/$(clubId)).data.creatorId == request.auth.uid ||
          clubMembers(get(/databases/$(database)/documents/bookClubs/$(clubId)).data).hasAny([request.auth.uid])
        );
        allow delete: if request.auth != null &&
          resource.data.senderId == request.auth.uid;
      }

      match /memberProgress/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid;
        allow update: if request.auth != null &&
          userId == request.auth.uid &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null &&
          userId == request.auth.uid;
      }
    }

    match /competitions/{competitionId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.creatorId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.creatorId == request.auth.uid &&
        request.resource.data.creatorId == resource.data.creatorId;
      allow delete: if request.auth != null &&
        resource.data.creatorId == request.auth.uid;

      match /participants/{userId} {
        allow read: if request.auth != null;
        allow create, update, delete: if false;
      }
    }

    match /userActivity/{activityId} {
      allow read: if request.auth != null && (
        activityId.matches(request.auth.uid + '_.*') ||
        (resource != null && resource.data.userId == request.auth.uid)
      );

      allow create: if request.auth != null &&
        activityId.matches(request.auth.uid + '_.*') &&
        request.resource.data.userId == request.auth.uid;

      // Counts can only increase — prevents resetting to 0 to bypass rate limits.
      // added upper bounds (10 000) to prevent MAX_INT injection.
      allow update: if request.auth != null &&
        activityId.matches(request.auth.uid + '_.*') &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.get('postCount', 0)            >= resource.data.get('postCount', 0) &&
        request.resource.data.get('commentCount', 0)         >= resource.data.get('commentCount', 0) &&
        request.resource.data.get('messageCount', 0)         >= resource.data.get('messageCount', 0) &&
        request.resource.data.get('bookSearchCount', 0)      >= resource.data.get('bookSearchCount', 0) &&
        request.resource.data.get('pollCount', 0)            >= resource.data.get('pollCount', 0) &&
        request.resource.data.get('voteChangeCount', 0)      >= resource.data.get('voteChangeCount', 0) &&
        request.resource.data.get('promptCount', 0)          >= resource.data.get('promptCount', 0) &&
        request.resource.data.get('promptResponseCount', 0)  >= resource.data.get('promptResponseCount', 0) &&
        request.resource.data.get('progressUpdateCount', 0)  >= resource.data.get('progressUpdateCount', 0) &&
        request.resource.data.get('postCount', 0)            <= 10000 &&
        request.resource.data.get('commentCount', 0)         <= 10000 &&
        request.resource.data.get('messageCount', 0)         <= 10000 &&
        request.resource.data.get('bookSearchCount', 0)      <= 10000 &&
        request.resource.data.get('pollCount', 0)            <= 10000 &&
        request.resource.data.get('voteChangeCount', 0)      <= 10000 &&
        request.resource.data.get('promptCount', 0)          <= 10000 &&
        request.resource.data.get('promptResponseCount', 0)  <= 10000 &&
        request.resource.data.get('progressUpdateCount', 0)  <= 10000;

      allow delete: if false;
    }

    // private lists were readable by all authenticated users — now owner-only when not public.
    match /bookLists/{listId} {
      allow read: if resource.data.isPublic == true ||
                   (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
                      resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null &&
                       resource.data.userId == request.auth.uid;
    }

    match /publicProfiles/{userId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(["username", "photoURL", "updatedAt", "bio", "occupation", "location", "createdAt"]) &&
        request.resource.data.keys().hasAll(["username", "updatedAt"]) &&
        request.resource.data.username is string &&
        request.resource.data.updatedAt is string &&
        (!("photoURL" in request.resource.data) || request.resource.data.photoURL is string) &&
        (!("bio" in request.resource.data) || request.resource.data.bio is string) &&
        (!("occupation" in request.resource.data) || request.resource.data.occupation is string) &&
        (!("location" in request.resource.data) || request.resource.data.location is string) &&
        (!("createdAt" in request.resource.data) || request.resource.data.createdAt is string);
      allow delete: if false;
    }

    match /usernames/{username} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null &&
        username == username.lower() &&
        request.resource.data.keys().hasOnly(['uid']) &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /users/{userId} {
      // block sensitive fields on create — Cloud Functions set these via Admin SDK, never the client.
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        !('hasCustomAiProvider' in request.resource.data) &&
        !('aiSettings' in request.resource.data) &&
        !('role' in request.resource.data) &&
        !('isAdmin' in request.resource.data);
      allow read: if request.auth != null && request.auth.uid == userId;

      // own-profile branch now also blocks sensitive BYOK/admin fields to prevent
      // self-elevating hasCustomAiProvider to bypass AI quotas.
      allow update: if request.auth != null && (
        // Own profile: any field except followers and sensitive admin/BYOK fields
        (userId == request.auth.uid &&
         request.resource.data.followers == resource.data.followers &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['hasCustomAiProvider', 'aiSettings', 'role', 'isAdmin', 'aiUsage', 'lastAiUsageDate'])) ||
        // Follow/unfollow: only the followers field may change
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']) && (
          // Follow: add yourself
          (request.resource.data.followers.size() == resource.data.followers.size() + 1 &&
           request.resource.data.followers.hasAll(resource.data.followers) &&
           !resource.data.followers.hasAny([request.auth.uid])) ||
          // Unfollow: remove yourself
          (request.resource.data.followers.size() == resource.data.followers.size() - 1 &&
           resource.data.followers.hasAll(request.resource.data.followers) &&
           resource.data.followers.hasAny([request.auth.uid]))
        ))
      );

      // Daily storage upload counters — written only by Cloud Functions (Admin SDK).
      match /_storageQuota/{dayKey} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /competitionJoins/{competitionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if false;
      }

      // Reading history is private. `allow read` grants list as well as get, so
      // opening it would let any signed-in user enumerate another user's whole
      // reading history. If public reading history is ever built, scope the
      // relaxation to get and read specific docs rather than listing.
      match /readingProgress/{storyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // create now requires userId == auth.uid — prevents posting into other users' subcollections.
      match /posts/{postId} {
        allow read: if true;
        allow create: if request.auth != null && userId == request.auth.uid;
        allow update: if request.auth != null && resource.data.authorId == request.auth.uid;
        allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      }
    }

    // MCP OAuth state (novelsync-agents MCP server). Written and read ONLY by
    // the agents service via the Admin SDK, which bypasses these rules; token
    // and code documents are keyed by SHA-256 hashes of the credentials.
    // Firestore is default-deny so these blocks change nothing — they exist to
    // document that no client SDK may ever touch these collections.
    match /mcpOauthClients/{clientId} {
      allow read, write: if false;
    }
    match /mcpOauthTxns/{txnId} {
      allow read, write: if false;
    }
    match /mcpOauthCodes/{codeHash} {
      allow read, write: if false;
    }
    match /mcpOauthTokens/{tokenHash} {
      allow read, write: if false;
    }
  }
}
